{
    "info": {
        "name": "Splitwise MVP API",
        "description": "Splitwise users, expenses, activity, and balances.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "server_url",
            "value": "http://localhost:3000"
        },
        {
            "key": "user_id",
            "value": "1"
        },
        {
            "key": "second_user_id",
            "value": "2"
        },
        {
            "key": "third_user_id",
            "value": "3"
        },
        {
            "key": "expense_id",
            "value": "1"
        }
    ],
    "item": [
        {
            "name": "Users",
            "item": [
                {
                    "name": "Create user",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Asha\",\n  \"email\": \"asha@example.com\",\n  \"password\": \"secret123\",\n  \"default_currency\": \"INR\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{server_url}}/users"
                    }
                },
                {
                    "name": "Get user",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-User-Id",
                                "value": "{{user_id}}"
                            }
                        ],
                        "url": "{{server_url}}/users/{{user_id}}"
                    }
                },
                {
                    "name": "Update user",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-User-Id",
                                "value": "{{user_id}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"default_currency\": \"USD\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{server_url}}/users/{{user_id}}"
                    }
                },
                {
                    "name": "Delete user",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "X-User-Id",
                                "value": "{{user_id}}"
                            }
                        ],
                        "url": "{{server_url}}/users/{{user_id}}"
                    }
                }
            ]
        },
        {
            "name": "Expenses",
            "item": [
                {
                    "name": "Create equal expense",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-User-Id",
                                "value": "{{user_id}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Dinner\",\n  \"value\": 1200,\n  \"currency\": \"INR\",\n  \"date\": \"2026-09-22\",\n  \"paid_by\": {{user_id}},\n  \"split_type\": \"EQUAL\",\n  \"members\": [\n    { \"user_id\": {{user_id}} },\n    { \"user_id\": {{second_user_id}} },\n    { \"user_id\": {{third_user_id}} }\n  ]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{server_url}}/expenses"
                    }
                },
                {
                    "name": "Create exact expense",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-User-Id",
                                "value": "{{user_id}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Hotel\",\n  \"value\": 3000,\n  \"currency\": \"INR\",\n  \"date\": \"2026-09-22\",\n  \"paid_by\": {{user_id}},\n  \"split_type\": \"EXACT\",\n  \"members\": [\n    { \"user_id\": {{user_id}}, \"share_amount\": 1500 },\n    { \"user_id\": {{second_user_id}}, \"share_amount\": 1000 },\n    { \"user_id\": {{third_user_id}}, \"share_amount\": 500 }\n  ]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{server_url}}/expenses"
                    }
                },
                {
                    "name": "Create percentage expense",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-User-Id",
                                "value": "{{user_id}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Trip taxi\",\n  \"value\": 1000,\n  \"currency\": \"INR\",\n  \"date\": \"2026-09-22\",\n  \"paid_by\": {{user_id}},\n  \"split_type\": \"PERCENTAGE\",\n  \"members\": [\n    { \"user_id\": {{user_id}}, \"percentage\": 50 },\n    { \"user_id\": {{second_user_id}}, \"percentage\": 30 },\n    { \"user_id\": {{third_user_id}}, \"percentage\": 20 }\n  ]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{server_url}}/expenses"
                    }
                },
                {
                    "name": "Get expense",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-User-Id",
                                "value": "{{user_id}}"
                            }
                        ],
                        "url": "{{server_url}}/expenses/{{expense_id}}"
                    }
                },
                {
                    "name": "Update expense",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "X-User-Id",
                                "value": "{{user_id}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Dinner updated\",\n  \"value\": 1500,\n  \"currency\": \"INR\",\n  \"date\": \"2026-09-22\",\n  \"paid_by\": {{user_id}},\n  \"split_type\": \"EQUAL\",\n  \"members\": [\n    { \"user_id\": {{user_id}} },\n    { \"user_id\": {{second_user_id}} },\n    { \"user_id\": {{third_user_id}} }\n  ]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{server_url}}/expenses/{{expense_id}}"
                    }
                },
                {
                    "name": "Delete expense",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "X-User-Id",
                                "value": "{{user_id}}"
                            }
                        ],
                        "url": "{{server_url}}/expenses/{{expense_id}}"
                    }
                },
                {
                    "name": "Activity current and last month",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-User-Id",
                                "value": "{{user_id}}"
                            }
                        ],
                        "url": "{{server_url}}/expenses/activity"
                    }
                },
                {
                    "name": "Activity custom range",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-User-Id",
                                "value": "{{user_id}}"
                            }
                        ],
                        "url": "{{server_url}}/expenses/activity?from=2026-09-01&to=2026-09-30"
                    }
                }
            ]
        },
        {
            "name": "Balances",
            "item": [
                {
                    "name": "Get balances",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-User-Id",
                                "value": "{{user_id}}"
                            }
                        ],
                        "url": "{{server_url}}/balances"
                    }
                }
            ]
        }
    ]
}